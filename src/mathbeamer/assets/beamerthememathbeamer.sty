\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerthememathbeamer}[2026/11/18 Math Beamer]
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[english]{babel}
\RequirePackage{amsmath,amssymb}

\usetheme{Madrid}
\usecolortheme{default}
\usefonttheme{professionalfonts}
\setbeamertemplate{blocks}[rounded][shadow=false]

\newsavebox{\MathBeamerBox}
\newcommand{\MathBeamerMeasure}[3][content]{%
  \sbox{\MathBeamerBox}{#2}%
  \ifdim\wd\MathBeamerBox>#3\relax
    \PackageError{mathbeamer}{Line too wide on frame \insertframenumber\space (#1)}%
      {Shorten the line. For the footer, set the corresponding short metadata.}%
  \fi
}
\newcommand{\MathBeamerLine}[1]{%
  \par\addvspace{0.4em}%
  \MathBeamerMeasure{#1}{\linewidth}%
  \noindent\usebox{\MathBeamerBox}\par
}
\newcommand{\MathBeamerBullet}[1]{%
  \MathBeamerLine{\makebox[\leftmargini][r]{%
    {\usebeamercolor[fg]{itemize item}\usebeamertemplate{itemize item}}\hspace{\labelsep}}#1}%
}
\newcommand{\MathBeamerEquation}[1]{%
  \par\addvspace{0.65em}%
  \MathBeamerMeasure{\(\displaystyle #1\)}{\linewidth}%
  \noindent\makebox[\linewidth][c]{\usebox{\MathBeamerBox}}\par
  \addvspace{0.45em}%
}

\addtobeamertemplate{frametitle}{%
  {\usebeamerfont{frametitle}%
   \MathBeamerMeasure[frame title]{\insertframetitle}{\dimexpr\paperwidth-0.6cm\relax}}%
}{}
\addtobeamertemplate{section in toc}{%
  {\MathBeamerMeasure[table of contents]{\inserttocsection}{\dimexpr\linewidth-2.75ex\relax}}%
}{}

% Check the three native Madrid footer boxes before Beamer typesets them.
\addtobeamertemplate{footline}{%
  {\usebeamerfont{author in head/foot}%
   \MathBeamerMeasure[short\string_author or short\string_affiliation]{%
     \insertshortauthor
     \expandafter\ifblank\expandafter{\beamer@shortinstitute}{}{~~(\insertshortinstitute)}%
   }{.333333\paperwidth}}%
  {\usebeamerfont{title in head/foot}%
   \MathBeamerMeasure[short\string_title]{\insertshorttitle}{.333333\paperwidth}}%
  {\usebeamerfont{date in head/foot}%
   \MathBeamerMeasure[short\string_date]{%
     \insertshortdate{}\hspace*{2em}%
     {\usebeamerfont{page number in head/foot}\usebeamertemplate{page number in head/foot}}%
     \hspace*{2ex}%
   }{.333333\paperwidth}}%
}{}
